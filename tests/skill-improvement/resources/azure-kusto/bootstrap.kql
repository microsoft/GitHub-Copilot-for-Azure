.create-merge table AppLogs (
  Timestamp:datetime,
  Service:string,
  Severity:string,
  Message:string,
  CorrelationId:string,
  Region:string,
  DurationMs:long,
  Success:bool,
  Properties:dynamic
)

.set-or-replace AppLogs <|
datatable(
  Timestamp:datetime,
  Service:string,
  Severity:string,
  Message:string,
  CorrelationId:string,
  Region:string,
  DurationMs:long,
  Success:bool,
  Properties:dynamic
)
