  datetime(2026-09-20T10:00:00Z), "Checkout", "Error", "Payment timeout", "corr-001", "westus2", 2500, false, dynamic({"tenantId":"contoso","featureName":"checkout"}),
  datetime(2026-09-20T10:05:00Z), "Checkout", "Critical", "Dependency unavailable", "corr-002", "eastus2", 5000, false, dynamic({"tenantId":"fabrikam","featureName":"checkout"}),
  datetime(2026-09-21T11:00:00Z), "Catalog", "Info", "Refresh completed", "corr-003", "westus2", 220, true, dynamic({"tenantId":"contoso","featureName":"catalog"}),
  datetime(2026-09-21T12:00:00Z), "Checkout", "Warning", "Retry scheduled", "corr-004", "eastus2", 900, true, dynamic({"tenantId":"fabrikam","featureName":"checkout"}),
  datetime(2026-09-22T13:00:00Z), "Identity", "Error", "Authentication failed", "corr-005", "eastus2", 2800, false, dynamic({"tenantId":"contoso","featureName":"identity"}),
  datetime(2026-09-22T14:00:00Z), "Checkout", "Error", "Inventory reservation failed", "corr-006", "westus2", 4100, false, dynamic({"tenantId":"fabrikam","featureName":"checkout"})
]

.create-merge table Requests (
  Timestamp:datetime,
  OperationId:string,
  Endpoint:string,
  Region:string,
  DurationMs:long,
  Success:bool,
  StatusCode:int,
  TenantId:string
)

.set-or-replace Requests <|
datatable(
  Timestamp:datetime,
  OperationId:string,
  Endpoint:string,
  Region:string,
  DurationMs:long,
  Success:bool,
  StatusCode:int,
  TenantId:string
)
[
  datetime(2026-09-20T10:00:00Z), "op-001", "/checkout", "westus2", 450, true, 200, "contoso",
  datetime(2026-09-20T10:10:00Z), "op-002", "/checkout", "westus2", 3200, false, 500, "contoso",
  datetime(2026-09-21T11:00:00Z), "op-003", "/login", "eastus2", 2800, false, 401, "fabrikam",
  datetime(2026-09-21T12:00:00Z), "op-004", "/catalog", "westus2", 220, true, 200, "contoso",
  datetime(2026-09-22T13:00:00Z), "op-005", "/checkout", "eastus2", 4100, false, 503, "fabrikam"
]

.create-merge table Dependencies (
  Timestamp:datetime,
  OperationId:string,
  Dependency:string,
  DurationMs:long,
  Success:bool
)

.set-or-replace Dependencies <|
datatable(
  Timestamp:datetime,
  OperationId:string,
  Dependency:string,
  DurationMs:long,
  Success:bool
)
[
  datetime(2026-09-20T10:00:00Z), "op-001", "Inventory", 120, true,
  datetime(2026-09-20T10:10:00Z), "op-002", "Payments", 2600, false,
  datetime(2026-09-21T11:00:00Z), "op-003", "Entra", 900, false,
  datetime(2026-09-21T12:00:00Z), "op-004", "Search", 180, true,
  datetime(2026-09-22T13:00:00Z), "op-005", "Inventory", 3500, false
]

.create-or-alter function with (
  folder = "Evaluation",
  docstring = "Returns failed request counts by region for a bounded interval."
) FailedRequestsByRegion(startTime:datetime, endTime:datetime) {
  Requests
  | where Timestamp between (startTime .. endTime)
  | where Success == false
  | summarize Failures=count() by Region
  | order by Region asc
}
